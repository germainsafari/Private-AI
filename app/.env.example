# OpenAI-compatible base URL (must end in /v1).
# WSL vLLM published to the Windows host:
OPENAI_BASE_URL=http://127.0.0.1:8080/v1

# Model id exactly as your server reports it (GET $OPENAI_BASE_URL/models).
MODEL_NAME=qwen3.6-35b-a3b

# Some servers ignore the API key; any non-empty value works.
API_KEY=not-needed
# Qwen3.x on vLLM: disable thinking tokens in chat (recommended)
LLM_DISABLE_THINKING=1
# Match vLLM --limit-mm-per-prompt '{"image":4}'
VLLM_MAX_IMAGES_PER_PROMPT=4
# VLLM_API_KEY=replace-with-a-long-random-secret

# Admission control (gateway-side)
MAX_CONCURRENCY=8
MAX_QUEUE_DEPTH=64
REQUEST_TIMEOUT_SECONDS=300
MAX_OUTPUT_TOKENS=4096

# Optional second backend for SLA-aware multi-model routing
# FAST_BASE_URL=http://127.0.0.1:8081/v1
# FAST_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# FAST_MAX_CONCURRENCY=8
# SLA_TTFT_MS=1500

# Optional. Overrides the default assistant personality.
# SYSTEM_PROMPT=You are a helpful AI assistant.

# Document ingest (POST /api/ingest)
# MAX_UPLOAD_MB=25
# Images are transcribed in batches of VLLM_MAX_IMAGES_PER_PROMPT; long text is
# condensed to fit the model context (see docs/DOCUMENT_INGEST.md).
# MAX_EXTRACT_CHARS=3000000
# MAX_VISION_IMAGES=60
# MAX_VISION_PAGES=60
# MAX_EMBEDDED_IMAGES=60
# MODEL_CONTEXT_TOKENS=65536
# MIN_PDF_TEXT_CHARS=40
# PDF_IMAGE_COVERAGE_THRESHOLD=0.55
# Legacy .doc / .odt / .rtf ? local only (LibreOffice)
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# SOFFICE_TIMEOUT_SECONDS=120

# File creation (POST /api/create) ? see docs/FILE_GENERATION.md
# Presentations: the Admind deck engine (Ppttx maker). The secret must equal its ENGINE_TOKEN_SECRET.
# DECK_ENGINE_URL=https://slides-api.admindagency.com
# DECK_ENGINE_TOKEN_SECRET=
# DECK_LINK_TTL_SECONDS=7200
# Optional image generation (any OpenAI-compatible /images/generations endpoint).
# Prompts leave your machine if this points at a hosted provider.
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1536x1024
# MAX_REPORT_IMAGES=4
# Report sizing
# MAX_REPORT_PAGES=40
# MAX_REPORT_SECTIONS=16
# SECTION_CONCURRENCY=6
