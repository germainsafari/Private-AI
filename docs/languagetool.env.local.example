# Copy this file to your app root as `.env.local` (Next.js) or add the same keys in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
#
# LanguageTool is NOT OpenAI-compatible. Your app must call POST {LANGUAGETOOL_URL}/v2/check
# Docs: https://dev.languagetool.org/public-http-api

# --- Use on Vercel / any cloud deploy (requires cloudflared tunnel running on your PC) ---
# Self-hosted with English n-gram data (~8GB) — see docs/LANGUAGETOOL.md
LANGUAGETOOL_URL=https://berry-wow-reflected-templates.trycloudflare.com

# --- Use only for local dev on the same machine as Docker LanguageTool ---
# LANGUAGETOOL_URL=http://127.0.0.1:8081

# Default language for /v2/check (ISO code: en-US, en-GB, de-DE, fr, etc.)
LANGUAGETOOL_DEFAULT_LANGUAGE=en-US

# Self-hosted LanguageTool has no API key. Leave empty or any placeholder.
LANGUAGETOOL_API_KEY=

# Optional: set to "1" in server-side code to prefer env over hardcoded URL
NEXT_PUBLIC_LANGUAGETOOL_ENABLED=0
